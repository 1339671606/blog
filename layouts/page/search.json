{{- $pages := partial "helper/pages.html" .Site.Home -}}
{{- $result := slice -}}
{{- range $pages -}}
    {{- $html := .Content -}}
    {{- $full := $html | plainify | htmlUnescape -}}
    {{- $prose := $html | replaceRE "(?is)<pre\\b[^>]*>.*?</pre>" " " | replaceRE "(?is)<h[1-6]\\b[^>]*>.*?</h[1-6]>" " " | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
    {{/* Split on actual rendered headings, preserving Hugo's Chinese and duplicate IDs. */}}
    {{- $headingPattern := `(?is)<h[1-6]\b[^>]*\bid="[^"]+"[^>]*>.*?</h[1-6]>` -}}
    {{- $sections := slice -}}
    {{- range split (replaceRE $headingPattern "READER_SECTION_BREAK$0" $html) "READER_SECTION_BREAK" -}}
        {{- $chunk := . -}}
        {{- $heading := index ((findRE $headingPattern $chunk 1) | default (slice "")) 0 -}}
        {{- $anchor := "" -}}{{- $title := "文章开头" -}}
        {{- if $heading -}}
            {{- $anchor = replaceRE `(?is)^.*?\bid="([^"]+)".*$` "$1" $heading | htmlUnescape -}}
            {{- $title = $heading | plainify | htmlUnescape | strings.TrimSpace -}}
        {{- end -}}
        {{- $text := $chunk | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
        {{- if $text -}}{{- $sections = $sections | append (dict "title" $title "anchor" $anchor "content" $text) -}}{{- end -}}
    {{- end -}}
    {{- $categories := slice -}}{{- range .GetTerms "categories" -}}{{- $categories = $categories | append .LinkTitle -}}{{- end -}}
    {{- $tags := slice -}}{{- range .GetTerms "tags" -}}{{- $tags = $tags | append .LinkTitle -}}{{- end -}}
    {{- $date := "" -}}{{- if not .Date.IsZero -}}{{- $date = .Date.Format "2006-01-02" -}}{{- end -}}
    {{- $result = $result | append (dict "title" .Title "permalink" .RelPermalink "content" $full "prose" $prose "sections" $sections "date" $date "dateLabel" (.Params.dateLabel | default "发布日期") "draft" .Draft "categories" $categories "tags" $tags) -}}
{{- end -}}
{{- $result | jsonify -}}
